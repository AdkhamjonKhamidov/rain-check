<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Rain Check</title>

    <link rel="icon" type="image/png" href="/images/favicon.png"> <!--links favicon-->

    <link rel="preconnect" href="https://fonts.googleapis.com"> <!--links google font - Barlow semi condensed-->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="style.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
</head>

<body class="background_color_light">
    <div class="header">
        <div class="title">
            <h1>Rain check</h1>
        </div>
    </div>
    <div class="buttons">
        <button type="button" data-unit="C">&deg;C</button>
        <button type="button" data-unit="F">&deg;F</button>
    </div>

    <div class="weather_body">
        <p>Temperature: <span class="temp"><%= weather.temp %></span> &deg;<span class="unit">C</span></p>
    </div>

    <script src="/main.js" defer></script>
</body>

</html>